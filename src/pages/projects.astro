---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
const statusLabel = { active: 'In progress', shipped: 'Shipped', archived: 'Archived' } as const;
---

<BaseLayout title="Projects" description="Things I've built and am building.">
	<div class="container narrow">
		<p class="eyebrow">Projects</p>
		<h1 class="page-title">Things I'm building</h1>
		<p class="page-lede">Side projects, experiments, and tools — some finished, some still in progress.</p>

		<ul class="projects">
			{
				rendered.map(({ p, Content }) => (
					<li id={`project-${p.id}`}>
						<div class="top">
							<h2>{p.data.title}</h2>
							<span class="status" data-status={p.data.status}>
								{statusLabel[p.data.status]} · {p.data.year}
							</span>
						</div>
						<p class="desc">{p.data.description}</p>
						<div class="prose small">
							<Content />
						</div>
						<div class="foot">
							{p.data.stack.length > 0 && (
								<ul class="stack">
									{p.data.stack.map((s) => <li>{s}</li>)}
								</ul>
							)}
							<div class="links">
								{p.data.link && <a href={p.data.link} target="_blank" rel="noopener">Visit <span class="arrow">↗</span></a>}
								{p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener">Source <span class="arrow">↗</span></a>}
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.projects {
		display: grid;
		gap: 1rem;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
	}
	.projects > li {
		padding: 1.5rem 1.6rem;
		background: var(--surface);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		transition: transform 0.3s var(--ease);
	}
	.projects > li:hover {
		transform: translateY(-2px);
	}
	.top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem 1rem;
	}
	h2 {
		font-size: 1.5rem;
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.status::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--muted);
	}
	.status[data-status='active']::before {
		background: var(--cat-life);
	}
	.status[data-status='shipped']::before {
		background: var(--cat-tech);
	}
	.desc {
		margin: 0.5rem 0 0;
		color: var(--text);
	}
	.small {
		font-size: 1rem;
		margin-top: 0.6rem;
	}
	.small :global(p) {
		margin: 0;
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1.1rem;
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.stack li {
		padding: 0.15rem 0.55rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 1rem;
		font-size: 0.875rem;
		font-weight: 500;
	}
	.links a {
		text-decoration: none;
	}
</style>
