---
import { CATEGORIES } from '../consts';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
	showCategory?: boolean;
}
const { posts, showCategory = true } = Astro.props;
---

<ol class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`} class="row" id={`post-${post.id}`}>
					<div class="meta">
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
						{showCategory && (
							<span class="cat" data-cat={post.data.category}>
								{CATEGORIES[post.data.category].label}
							</span>
						)}
					</div>
					<div class="body">
						<h3>
							{post.data.title}
							{post.data.draft && <span class="draft">Draft</span>}
						</h3>
						<p>{post.data.description}</p>
						<span class="read">
							{readingTime(post.body)} min read <span class="arrow">→</span>
						</span>
					</div>
				</a>
			</li>
		))
	}
</ol>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		border-top: 1px solid var(--border);
	}
	.row {
		display: grid;
		grid-template-columns: 9.5rem 1fr;
		gap: 0.5rem 2rem;
		padding: 1.6rem 0.9rem;
		margin-inline: -0.9rem;
		border-radius: var(--radius);
		text-decoration: none;
		transition: background-color 0.25s var(--ease);
	}
	.row:hover {
		background: var(--surface);
		color: inherit;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-top: 0.3rem;
		font-size: 0.85rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	h3 {
		font-size: 1.45rem;
		color: var(--text);
		transition: color 0.2s;
	}
	.row:hover h3 {
		color: var(--accent);
	}
	p {
		margin: 0.4rem 0 0.6rem;
		color: var(--text-soft);
		font-size: 0.975rem;
	}
	.read {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.draft {
		margin-left: 0.5rem;
		padding: 0.1rem 0.45rem;
		border: 1px dashed var(--muted);
		border-radius: 5px;
		font-family: var(--font-sans);
		font-size: 0.7rem;
		vertical-align: middle;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.row {
			grid-template-columns: 1fr;
			padding-block: 1.3rem;
		}
		.meta {
			flex-direction: row;
			gap: 1rem;
			padding-top: 0;
		}
	}
</style>
